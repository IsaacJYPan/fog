# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.mypy_cache/
.pytest_cache/
.pytest-tmp*/
.pytest-cache-local/
.test-runs/
.ruff_cache/
.uv-cache/
.test_tmp*/
.pytest_tmp*/
/.tools/

# Data artifacts (immutable raw + regenerable derived) — regenerate from pinned sources
data/raw_replays/*
data/parsed/*
data/usage/*
data/team_bank_cache/
!data/**/.gitkeep

# Team pools: the hand-built PASTES are irreplaceable experiment definitions — TRACKED.
# Only the derived packaged banks (regenerable via fog.scripts.build_team_pools) stay out.
data/teams/*.json
data/teams/public_*/
data/teams/gen9ou_public_v*/
# ... except the generative bank's package: its _meta IS the provenance record (seed, mass cut,
# core, per-slot entropy report) for the committed pool_gen pastes.
!data/teams/pool_gen.json

# Generated constants are TRACKED (small JSON, pinned provenance: Showdown commit + usage month in
# configs/default.yaml::pins). Committing them removes a regeneration failure mode — the
# "_meta commit unknown" bridge bug already bit once.

# Simulator checkout is a real submodule pinned to the same commit recorded in default.yaml.
# Build products and local logs belong inside the submodule and must never change its gitlink.

# Training artifacts
runs/
/checkpoints/
/artifacts/*.zip
*.ckpt
*.pt
!artifacts/checkpoints/*.pt

# Course materials (personal study track, not project source)
course/

# OS / editors
.DS_Store
.idea/
.vscode/

# Track maintained project documentation explicitly.
/*.md
!/README.md
!/KAGGLE_TRAINING.md
!/ARCHITECTURE.md
!/TECHNICAL_DEBT.md
!/HIGH_LEVEL_TRAINING_PLAN.md
server/README.md
